// Every block in the game, one entry each. Air is built in, don't list it.
//
// Adding a block: draw its 8x8 png in assets/images/blocks, add a line here,
// and use it in code as `Block::NAME` (the name in capitals).
//
// Fields (only `name` is required):
//   name:     lowercase letters, digits and _. Also its texture file's name
//   solid:    false for blocks you can walk through. Default true (false for fluids)
//   fluid:    true for water and the like: walked through, drawn see-through
//             (the png's alpha is used), and blocks can be placed into it
//   see_through: true for solid blocks with gaps, like leaves: pixels with
//             alpha 0 are holes you see (and light shines) through, and the
//             faces of blocks behind them are still drawn
//   textures: (top: "...", side: "...", bottom: "...") picks a png per face,
//             by file name without .png. Faces left out use the block's name.
//             e.g. (name: "grass", textures: (top: "grass_top", bottom: "dirt"))
//
// A block's id is its position in this list, so reordering changes ids. That's
// fine: the client and server are always built from the same file, and saves
// will store names.

// lets optional fields be written plainly, e.g. `top: "grass_top"`
#![enable(implicit_some)]
[
    (name: "stone"),
    (name: "dirt"),
    (name: "grass"),
    (name: "sand"),
    (name: "gravel"),
    (name: "snow"),
    (name: "water", fluid: true),
    (name: "dry_grass"),
    (name: "podzol"),
    (name: "sandstone"),
    (name: "oak_log", textures: (top: "oak_log_top", side: "oak_log_side", bottom: "oak_log_top")),
    (name: "oak_leaves", see_through: true),
]
